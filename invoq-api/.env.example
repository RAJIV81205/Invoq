# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── Database (MongoDB) ───────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/invoq
MONGODB_DB=invoq

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# Or use discrete connection vars instead of REDIS_URL:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false

