# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── Database (MongoDB) ───────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/invoq
MONGODB_DB=invoq

# ─── Redis (local) ───────────────────────────────────────────────────────────
# Preferred: point at local Redis on 127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
# Or use discrete connection vars instead of REDIS_URL:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false

# ─── Stellar ──────────────────────────────────────────────────────────────────
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK=testnet
STELLAR_ADMIN_SECRET=S...

# ─── Contract addresses ───────────────────────────────────────────────────────
SUBSCRIPTION_REGISTRY_CONTRACT_ADDRESS=CC5FVK42PNUGPQZRYDYW7EVRIQIW2GTNPF6TVMZBBVPCLLDMJZLKU3PF
BILLING_CYCLE_CONTRACT_ADDRESS=CAR6HPIXMNI4B4GONOWCXLN2N7VHH45FEX7IM2JDARR7XZHETNVDUUOR
ESCROW_VAULT_CONTRACT_ADDRESS=CBANJOGMJZ3CAIHX45UWUTDUVXZIMUYOZPXNHYZLKKHZBQ5ZAR6L2LLO
SPEND_POLICY_CONTRACT_ADDRESS=CDTLW43XT55X5FZB3PPC5Y7UG6PSYC4LW3ZED23YIEIVDXVOT72QHFPG
USDC_SAC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Legacy aliases (kept for backward compatibility)
BILLING_CONTRACT_ID=CAR6HPIXMNI4B4GONOWCXLN2N7VHH45FEX7IM2JDARR7XZHETNVDUUOR
ESCROW_VAULT_CONTRACT_ID=CBANJOGMJZ3CAIHX45UWUTDUVXZIMUYOZPXNHYZLKKHZBQ5ZAR6L2LLO

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Base URL the Next.js dashboard uses to reach the invoq-api. Defaults to
# http://localhost:3001 for local dev.
NEXT_PUBLIC_INVOQ_API_URL=http://localhost:3001
INVOQ_API_URL=http://localhost:3001

# Secret key used by the test page at /test. Generate with:
#   cd invoq-api && npx tsx test/gen-key.ts
TEST_API_KEY=sk_live_...
TEST_CUSTOMER_ADDRESS=G...
